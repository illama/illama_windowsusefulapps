<Window x:Class="SystemManagerPro.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saisie" Height="290" Width="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BgElevated}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid Margin="26,24,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="Titre" FontSize="16" FontWeight="SemiBold"/>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock x:Name="Field1Label" Text="Champ 1" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <TextBox x:Name="Field1Box" Style="{StaticResource Input}"/>
            </StackPanel>

            <StackPanel x:Name="Field2Panel" Grid.Row="2" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Field2Label" Text="Champ 2" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Field2Box" Grid.Column="0" Style="{StaticResource Input}"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="Parcourir…" Style="{StaticResource BtnBase}"
                            Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource Danger}" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Bottom" Visibility="Collapsed"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Annuler" Style="{StaticResource BtnGhost}" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Valider" Style="{StaticResource BtnPrimary}" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
