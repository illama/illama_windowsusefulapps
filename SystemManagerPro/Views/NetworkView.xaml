<UserControl x:Class="SystemManagerPro.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer Style="{StaticResource CleanScrollViewer}">
        <StackPanel Margin="32,26,32,26">
            <TextBlock Text="Réseau" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Diagnostic des adaptateurs et outils de dépannage réseau courants." Style="{StaticResource PageSubtitle}"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Adaptateurs réseau" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🔄  Actualiser" Style="{StaticResource BtnBase}" Click="Refresh_Click"/>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                <DataGrid x:Name="AdaptersGrid" Margin="6" MaxHeight="240">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOM" Binding="{Binding Nom}" Width="1.2*"/>
                        <DataGridTextColumn Header="STATUT" Binding="{Binding Statut}" Width="0.8*"/>
                        <DataGridTextColumn Header="ADRESSE IPV4" Binding="{Binding Ipv4}" Width="1*"/>
                        <DataGridTextColumn Header="PASSERELLE" Binding="{Binding Passerelle}" Width="1*"/>
                        <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="1.4*"/>
                        <DataGridTextColumn Header="VITESSE" Binding="{Binding VitesseMbps, StringFormat={}{0} Mb/s}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Outils de dépannage" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="🧽  Vider le cache DNS" Style="{StaticResource BtnBase}" Margin="0,0,10,10" Click="FlushDns_Click"/>
                        <Button Content="🔌  Réinitialiser Winsock" Style="{StaticResource BtnBase}" Margin="0,0,10,10" Click="ResetWinsock_Click"/>
                        <Button Content="🌐  Réinitialiser TCP/IP" Style="{StaticResource BtnBase}" Margin="0,0,10,10" Click="ResetTcpIp_Click"/>
                        <Button Content="🔁  Renouveler l'adresse IP" Style="{StaticResource BtnBase}" Margin="0,0,10,10" Click="Renew_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ToolOutput" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Test de ping" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PingHostBox" Style="{StaticResource Input}" Text="8.8.8.8" MaxWidth="300" HorizontalAlignment="Left"/>
                        <Button Grid.Column="1" Content="📡  Envoyer 4 pings" Style="{StaticResource BtnPrimary}" Click="Ping_Click"/>
                    </Grid>
                    <ItemsControl x:Name="PingResults" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
