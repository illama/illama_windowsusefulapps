<UserControl x:Class="SystemManagerPro.Views.WheelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer Style="{StaticResource CleanScrollViewer}">
        <StackPanel Margin="32,26,32,26">
            <TextBlock Text="Molette" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Contrôlez la puissance de défilement de la molette : pour tout l'ordinateur, ou pour une seule application ciblée."
                       Style="{StaticResource PageSubtitle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <RadioButton x:Name="TabGlobal" Style="{StaticResource PillTab}" GroupName="WheelMode" Content="🖥️  Tout l'ordinateur"
                             IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabApp" Style="{StaticResource PillTab}" GroupName="WheelMode" Content="🎯  Application spécifique" Checked="Tab_Checked"/>
            </StackPanel>

            <!-- ===== Mode global ===== -->
            <StackPanel x:Name="GlobalPanel" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Défilement vertical" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="VerticalValueText" Grid.Column="1" Text="3 lignes • 15%"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Nombre de lignes défilées par cran de molette. Réglage Windows par défaut : 3."
                                   Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                        <Slider x:Name="VerticalSlider" Style="{StaticResource AppSlider}" Minimum="1" Maximum="20" ValueChanged="VerticalSlider_ValueChanged"/>
                        <ProgressBar x:Name="VerticalMeter" Maximum="100" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Défilement horizontal" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="HorizontalValueText" Grid.Column="1" Text="3 caractères • 15%"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Défilement horizontal (ex. Maj + molette, ou pavé tactile). Défaut : 3."
                                   Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                        <Slider x:Name="HorizontalSlider" Style="{StaticResource AppSlider}" Minimum="1" Maximum="20" ValueChanged="HorizontalSlider_ValueChanged"/>
                        <ProgressBar x:Name="HorizontalMeter" Maximum="100" Margin="0,14,0,0" Foreground="{StaticResource Accent2}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Zone de test en direct" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Passez la souris ici et scrollez pour voir l'effet du réglage actuel."
                                           Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="↺  Réinitialiser" Style="{StaticResource BtnBase}" Click="ResetTestStats_Click"/>
                        </Grid>

                        <Border x:Name="TestZone" Height="130" CornerRadius="10" Margin="0,14,0,0"
                                Background="{StaticResource BgElevated2}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                PreviewMouseWheel="TestZone_PreviewMouseWheel">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TestZoneIcon" Text="🖱️" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TestZoneText" Text="Scrollez ici pour tester…" Style="{StaticResource Muted}"
                                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="TestNotchesValue" Text="0" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Crans détectés" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock x:Name="TestLinesValue" Text="0" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Lignes équivalentes" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="TestPowerValue" Text="15%" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="Puissance actuelle" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Button Content="Réinitialiser les valeurs Windows par défaut (3 / 3)" Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetGlobalDefaults_Click"/>
            </StackPanel>

            <!-- ===== Mode application spécifique ===== -->
            <StackPanel x:Name="AppPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Application ciblée" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Seule la molette utilisée au-dessus de cette application (ou de tout exécutable situé dans ce dossier) sera modifiée — le reste de l'ordinateur n'est jamais affecté."
                                   Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"/>

                        <Border Background="{StaticResource BgElevated2}" CornerRadius="8" Padding="12,10">
                            <TextBlock x:Name="TargetPathText" Text="Aucune application choisie." FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="📄  Choisir un .exe" Style="{StaticResource BtnBase}" Click="ChooseExe_Click" Margin="0,0,8,0"/>
                            <Button Content="📁  Choisir un dossier" Style="{StaticResource BtnBase}" Click="ChooseFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Multiplicateur de puissance" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="MultiplierValueText" Grid.Column="1" Text="x2.0 • 200%"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="x1 = comportement normal. Au-delà de x1, chaque cran de molette défile plus loin dans l'application ciblée ; en dessous, moins loin."
                                   Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <Slider x:Name="MultiplierSlider" Style="{StaticResource AppSlider}" Minimum="0.25" Maximum="8" TickFrequency="0.25" ValueChanged="MultiplierSlider_ValueChanged"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Activation" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="AppStatusText" Text="Désactivée." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AppEnabledToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="AppEnabledToggle_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Statistiques en direct" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="LiveStatText" Text="En attente d'un mouvement de molette sur l'application ciblée…"
                                   Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="TotalBoostedValue" Text="0" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Évènements amplifiés" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="MultiplierPercentValue" Text="200%" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="Puissance appliquée" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
