<UserControl x:Class="SystemManagerPro.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Installateur d'applications" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="0" Text="Installe en un clic navigateurs, launchers de jeux et utilitaires courants (via winget)." Style="{StaticResource PageSubtitle}" Margin="0,32,0,0"/>

        <Border x:Name="WingetMissingCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0"
                Background="#2A1A1A" BorderBrush="{StaticResource Danger}" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontSize="12.5">
                <Run Text="⚠️ winget (Windows Package Manager) est introuvable sur ce PC."/>
                <LineBreak/>
                <Run Text="Installe 'App Installer' depuis le Microsoft Store, puis reviens sur cette page."/>
            </TextBlock>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" MaxWidth="360" HorizontalAlignment="Left"
                     TextChanged="SearchBox_TextChanged" Tag="Rechercher une application…"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔍  Scanner les applications installées" Style="{StaticResource BtnBase}" Click="Scan_Click" Margin="0,0,8,0"/>
                <Button x:Name="InstallSelectionBtn" Content="⬇️  Installer la sélection" Style="{StaticResource BtnPrimary}" Click="InstallSelection_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0" x:Name="CategoryPills"/>

        <ScrollViewer Grid.Row="4" Style="{StaticResource CleanScrollViewer}" Margin="0,16,0,0">
            <StackPanel x:Name="CatalogStack"/>
        </ScrollViewer>
    </Grid>
</UserControl>
