<UserControl x:Class="SystemManagerPro.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Processus" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="0" Text="Mini gestionnaire des tâches : usage CPU/mémoire en temps réel." Style="{StaticResource PageSubtitle}" Margin="0,32,0,0"/>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" MaxWidth="360" HorizontalAlignment="Left"
                     TextChanged="SearchBox_TextChanged" Tag="Rechercher un processus…"/>
            <Button Grid.Column="1" Content="🔄  Actualiser" Style="{StaticResource BtnBase}" Click="Refresh_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0" x:Name="StatsPanel"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
            <DataGrid x:Name="ProcessGrid" Margin="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOM" Binding="{Binding Name}" Width="1.6*"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="0.7*"/>
                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}}" Width="0.8*"/>
                    <DataGridTextColumn Header="MÉMOIRE (Mo)" Binding="{Binding MemoryMb, StringFormat={}{0:0.#}}" Width="1*"/>
                    <DataGridTextColumn Header="THREADS" Binding="{Binding Threads}" Width="0.7*"/>
                    <DataGridTemplateColumn Header="" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Arrêter" Style="{StaticResource BtnDanger}" Click="EndTask_Click" Padding="10,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
