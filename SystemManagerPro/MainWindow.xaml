<Window x:Class="SystemManagerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gestionnaire Système Pro" Height="760" Width="1240" MinHeight="600" MinWidth="980"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Barre de titre personnalisée ===== -->
            <Grid Grid.Row="0" Background="{StaticResource BgElevated}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="⚙" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Gestionnaire Système Pro" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Background="{StaticResource BgElevated3}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="v2.4" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                    </Border>
                </StackPanel>

                <Button x:Name="SearchHintBtn" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="12,5" Click="OpenPalette_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Text="Rechercher une action…" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                        <Border Background="{StaticResource BgElevated3}" CornerRadius="4" Padding="5,1" Margin="10,0,0,0">
                            <TextBlock Text="Ctrl+K" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        </Border>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Réduire">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource TitleBarButton}" Click="MaximizeRestore_Click" ToolTip="Agrandir">
                        <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" ToolTip="Fermer">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Corps : barre latérale + contenu ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="234"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BgElevated}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Style="{StaticResource CleanScrollViewer}" Grid.Row="0">
                            <StackPanel x:Name="NavStack" Margin="0,14,0,0">
                                <TextBlock Text="NAVIGATION" Style="{StaticResource Muted}" Margin="22,4,0,10" FontWeight="SemiBold"/>

                                <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🏠"
                                             Content="Tableau de bord" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🚀"
                                             Content="Démarrage" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavServices" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🧩"
                                             Content="Services" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavProcesses" Style="{StaticResource NavItem}" GroupName="Nav" Tag="📊"
                                             Content="Processus" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavLanguage" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🌐"
                                             Content="Langues" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavKeyboard" Style="{StaticResource NavItem}" GroupName="Nav" Tag="⌨"
                                             Content="Clavier" Checked="Nav_Checked"/>

                                <TextBlock Text="OUTILS" Style="{StaticResource Muted}" Margin="22,18,0,10" FontWeight="SemiBold"/>

                                <RadioButton x:Name="NavInstaller" Style="{StaticResource NavItem}" GroupName="Nav" Tag="📦"
                                             Content="Installateur" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavCleanup" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🧹"
                                             Content="Nettoyage" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItem}" GroupName="Nav" Tag="📡"
                                             Content="Réseau" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavUninstaller" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🗑"
                                             Content="Programmes" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🧬"
                                             Content="Avancé" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavTweaks" Style="{StaticResource NavItem}" GroupName="Nav" Tag="🛠"
                                             Content="Réglages rapides" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="Nav" Tag="📜"
                                             Content="Journal" Checked="Nav_Checked"/>

                                <TextBlock Text="APPLICATION" Style="{StaticResource Muted}" Margin="22,18,0,10" FontWeight="SemiBold"/>

                                <Grid x:Name="NavSettingsRow">
                                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Tag="⚙️"
                                                 Content="Paramètres" Checked="Nav_Checked"/>
                                    <Ellipse x:Name="SettingsUpdateDot" Width="8" Height="8" Fill="{StaticResource Danger}"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,0,0,0"
                                             IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="UpdateDotScale"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Badge statut admin -->
                        <Border Grid.Row="1" Margin="14,10,14,16" Padding="10,9" CornerRadius="10"
                                Background="{StaticResource BgElevated2}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock Text="Droits administrateur" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="UserLabel" Text="—" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Zone de contenu -->
                <Grid Grid.Column="1" Background="{StaticResource BgBase}" ClipToBounds="True">
                    <ContentControl x:Name="MainContent" Focusable="False" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="ContentTransform" Y="0"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- Toast de notification -->
                    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,26,26" Padding="16,12" CornerRadius="10" MaxWidth="380"
                            Background="{StaticResource BgElevated3}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" Opacity="0.4" ShadowDepth="4" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ToastDot" Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,4,10,0"/>
                            <TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="12.5" MaxWidth="320"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Palette de commandes (Ctrl+K) ===== -->
                <Grid x:Name="PaletteOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" MouseLeftButtonDown="PaletteOverlay_MouseLeftButtonDown">
                    <Grid.Background>
                        <SolidColorBrush Color="Black" Opacity="0.45"/>
                    </Grid.Background>
                    <Border x:Name="PaletteBox" Width="560" MaxHeight="440" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,90,0,0" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1" CornerRadius="12" MouseLeftButtonDown="PaletteBox_MouseLeftButtonDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="8" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBox x:Name="PaletteInput" Style="{StaticResource Input}" BorderThickness="0,0,0,1"
                                     Tag="Rechercher une page ou une action…" FontSize="15" Padding="18,16"
                                     TextChanged="PaletteInput_TextChanged" PreviewKeyDown="PaletteInput_PreviewKeyDown"/>
                            <ScrollViewer Style="{StaticResource CleanScrollViewer}" MaxHeight="360">
                                <StackPanel x:Name="PaletteResults" Margin="8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
