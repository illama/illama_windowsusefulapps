<Window x:Class="SystemManagerPro.Dialogs.AdminLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion administrateur" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BgElevated}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid Margin="26,24,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡️" FontSize="18"/>
                <TextBlock Text="Zone administrateur" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="Identifiant" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <TextBox x:Name="UserBox" Style="{StaticResource Input}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="Mot de passe" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PassBox" Background="{StaticResource BgElevated2}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="10,7" FontSize="13"
                             CaretBrush="{StaticResource Accent}" KeyDown="PassBox_KeyDown"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource Danger}" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Bottom" Visibility="Collapsed"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Annuler" Style="{StaticResource BtnGhost}" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="LoginBtn" Content="Se connecter" Style="{StaticResource BtnPrimary}" Click="Login_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
